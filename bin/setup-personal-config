#!/usr/bin/env bash

# Create config/zsh/personal.local from its template

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
TEMPLATE_FILE="$DOTFILES/config/zsh/personal.local.template"
CONFIG_FILE="$DOTFILES/config/zsh/personal.local"

main() {
    if [[ ! -f $TEMPLATE_FILE ]]; then
        echo "Template not found: $TEMPLATE_FILE" >&2
        exit 1
    fi

    if [[ -f $CONFIG_FILE ]]; then
        echo "Personal config already exists: $CONFIG_FILE"
        read -r -p "Overwrite it? (y/N): " choice
        case "$choice" in
            [yY] | [yY][eE][sS])
                cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d_%H%M%S)"
                ;;
            *)
                echo "Kept $CONFIG_FILE. Template: $TEMPLATE_FILE"
                exit 0
                ;;
        esac
    fi

    cp "$TEMPLATE_FILE" "$CONFIG_FILE"

    echo "Created $CONFIG_FILE"
    echo "Add PATH entries, aliases and functions there, then run: source ~/.zshrc"
    echo "Git ignores this file, so it is not backed up with the repo."

    if [[ -n ${EDITOR:-} ]] && command -v "$EDITOR" >/dev/null 2>&1; then
        read -r -p "Edit it now? (y/N): " edit_choice || true
        case "${edit_choice:-}" in
            [yY] | [yY][eE][sS])
                "$EDITOR" "$CONFIG_FILE"
                ;;
        esac
    fi
}

main "$@"
