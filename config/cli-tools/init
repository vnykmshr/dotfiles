# CLI Tools - merged configuration
# Initializes modern CLI replacements: eza, bat, rg, fd, delta, zoxide

# --- eza ---
if command -v eza >/dev/null 2>&1; then
    export EZA_COLORS="ur=1;32:uw=1;31:ux=1;36:ue=1;36:gr=1;32:gw=1;31:gx=1;36:tr=1;32:tw=1;31:tx=1;36:su=1;37:sf=1;37:xa=1;34:da=1;34:in=1;33:bl=1;33:ex=1;32:"

    alias ls='eza --color=auto --group-directories-first'
    alias ll='eza -la --color=auto --group-directories-first --git'
    alias la='eza -la --color=auto --group-directories-first'
    alias lt='eza --tree --level=2 --color=auto'
    alias lta='eza --tree --level=2 --color=auto --all'
fi

# --- bat ---
if command -v bat >/dev/null 2>&1; then
    export BAT_THEME="Monokai Extended"
    export BAT_STYLE="numbers,changes,header,grid"
    export BAT_PAGER="less -RF"
    export BAT_TABS="4"

    alias less='bat --style=auto --paging=always'
fi

# --- ripgrep ---
if command -v rg >/dev/null 2>&1; then
    [[ -f "$HOME/.config/ripgrep/config" ]] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

    alias rga='rg --no-ignore --hidden'
    alias rgf='rg --files'
fi

# --- fd ---
if command -v fd >/dev/null 2>&1; then
    alias fda='fd --no-ignore --hidden'
    alias fdt='fd --type f'
    alias fdd='fd --type d'
fi

# --- delta ---
if command -v delta >/dev/null 2>&1; then
    alias gd='git diff'
    alias gdc='git diff --cached'
    alias gds='git diff --stat'
    alias gshow='git show'
fi

# --- zoxide ---
if command -v zoxide >/dev/null 2>&1; then
    export _ZO_ECHO=1
    export _ZO_RESOLVE_SYMLINKS=1
    eval "$(zoxide init zsh)"
    alias zb='z -'
fi

# --- diagnostics ---
check_modern_tools() {
    local tools=("eza:ls" "bat:cat" "rg:grep" "fd:find" "delta:diff" "zoxide:cd")
    for entry in "${tools[@]}"; do
        local cmd="${entry%%:*}" desc="${entry##*:}"
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '  installed  %s (%s replacement)\n' "$cmd" "$desc"
        else
            printf '  MISSING    %s (%s replacement)\n' "$cmd" "$desc"
        fi
    done
}
alias tools='check_modern_tools'
