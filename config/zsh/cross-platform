# Linux/WSL clipboard and open shims, WSL PATH cleanup, and line-editing and
# word-movement keys.

if [[ "$OSTYPE" == linux* ]]; then
    _dotfiles_wsl=0
    [[ -n "$WSL_DISTRO_NAME" || -n "$WSL_INTEROP" ]] && _dotfiles_wsl=1

    if command -v xclip >/dev/null 2>&1; then
        alias pbcopy='xclip -selection clipboard'
        alias pbpaste='xclip -selection clipboard -o'
    elif command -v xsel >/dev/null 2>&1; then
        alias pbcopy='xsel --clipboard --input'
        alias pbpaste='xsel --clipboard --output'
    elif ((_dotfiles_wsl)); then
        alias pbcopy='clip.exe'
        alias pbpaste='powershell.exe -command "Get-Clipboard"'
    fi

    if command -v xdg-open >/dev/null 2>&1; then
        alias open='xdg-open'
    elif ((_dotfiles_wsl)); then
        alias open='explorer.exe'
    fi

    # Drop the Windows paths WSL appends to PATH
    ((_dotfiles_wsl)) && path=(${path:#/mnt/c/*})
    unset _dotfiles_wsl
fi

# Word movement
if [[ "$OSTYPE" == darwin* ]]; then
    bindkey '^[[1;3D' backward-word # Alt+Left
    bindkey '^[[1;3C' forward-word  # Alt+Right
else
    bindkey '^[[1;5D' backward-word # Ctrl+Left
    bindkey '^[[1;5C' forward-word  # Ctrl+Right
fi

# Line editing
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^K' kill-line
bindkey '^U' backward-kill-line
bindkey '^W' backward-kill-word
