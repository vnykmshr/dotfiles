# Generated by install/setup.sh from config.json; rewritten on every install.
# Put your own exports in config/zsh/personal.local instead.

export WORKSPACE="{{WORKSPACE_DIR}}"
export PROJECTS="{{PROJECTS_DIR}}"
export PERSONAL_BIN="{{PERSONAL_BIN_DIR}}"

# Append personal bin to PATH; zshrc order (brew first) wins for dirs already listed
[[ -d "$PERSONAL_BIN" ]] && path+=("$PERSONAL_BIN")
