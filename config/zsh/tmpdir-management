# Temp directory management

DOTFILES_TMPDIR="${DOTFILES_TMPDIR:-$HOME/tmp}"

if [[ ! -d "$DOTFILES_TMPDIR" ]]; then
    mkdir -p "$DOTFILES_TMPDIR"
    chmod 700 "$DOTFILES_TMPDIR"
fi

export TMPDIR="$DOTFILES_TMPDIR"

# Clean files older than 7 days (background, once per shell)
(find "$DOTFILES_TMPDIR" -type f -mtime +7 -delete 2>/dev/null &)
